#!/bin/bash
# zeughaus-ro-watch v0.3
# Detects loss of write access to the root Btrfs filesystem and captures
# forensic evidence into /run, which remains writable if / becomes read-only.

set -u

INTERVAL=10
COMMAND_TIMEOUT=15
BASE=/run/zeughaus-ro-watch
TEST=/root/.zeughaus-rw-watch-test

mkdir -p "$BASE"
chmod 700 "$BASE"

log() {
    printf '%s %s\n' "$(date --iso-8601=ns)" "$*" | systemd-cat -t zeughaus-ro-watch -p info
}

run_capture() {
    local outfile="$1"
    shift
    timeout --kill-after=2s "${COMMAND_TIMEOUT}s" "$@" > "$outfile" 2>&1 || true
}

write_test() {
    local path="$1"
    python3 - "$path" <<'PY'
import errno, os, sys

path = sys.argv[1]
try:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, b"write-test\n")
    finally:
        os.close(fd)
    os.unlink(path)
    print("RESULT=WRITE_OK")
    sys.exit(0)
except OSError as e:
    print("RESULT=WRITE_FAILED")
    print(f"ERRNO={e.errno}")
    print(f"ERRNAME={errno.errorcode.get(e.errno, 'UNKNOWN')}")
    print(f"ERROR={e}")
    sys.exit(1)
PY
}

capture() {
    local incident="$1"
    local dir="$BASE/$incident"
    mkdir -p "$dir"
    chmod 700 "$dir"

    # Write the minimal trigger record first. If a later forensic command hangs,
    # this file still tells us exactly why and when the incident was triggered.
    {
        printf 'timestamp=%s\n' "$(date --iso-8601=ns)"
        printf 'errno=%s\n' "${WRITE_ERRNO:-unknown}"
        printf 'errname=%s\n' "${WRITE_ERRNAME:-unknown}"
        printf 'error=%s\n' "${WRITE_ERROR:-unknown}"
        printf 'write_rc=%s\n' "${WRITE_RC:-unknown}"
        printf 'root_state_before_capture=\n'
        timeout --kill-after=2s "${COMMAND_TIMEOUT}s" findmnt -no TARGET,FSTYPE,OPTIONS / 2>&1 || true
    } > "$dir/INCIDENT_TRIGGER.txt"

    date --iso-8601=ns > "$dir/timestamp.txt"
    printf 'hostname=%s\n' "$(hostname)" > "$dir/host.txt"

    run_capture "$dir/root-mount.txt" findmnt -T /
    run_capture "$dir/run-mount.txt" findmnt -T /run
    run_capture "$dir/mounts.txt" mount
    run_capture "$dir/proc-mounts.txt" cat /proc/mounts
    run_capture "$dir/proc-mountinfo.txt" cat /proc/self/mountinfo

    run_capture "$dir/btrfs-filesystem-show.txt" btrfs filesystem show /
    run_capture "$dir/btrfs-filesystem-usage.txt" btrfs filesystem usage /
    run_capture "$dir/btrfs-filesystem-df.txt" btrfs filesystem df /
    run_capture "$dir/btrfs-device-stats.txt" btrfs device stats /
    run_capture "$dir/btrfs-default-subvolume.txt" btrfs subvolume get-default /
    run_capture "$dir/btrfs-root-property-ro.txt" btrfs property get -ts / ro

    run_capture "$dir/kernel-last-2000.txt" journalctl -b -k -n 2000 -o short-monotonic
    run_capture "$dir/kernel-btrfs-nvme-ro.txt" bash -c 'journalctl -b -k -n 2000 -o short-monotonic | grep -Ei "btrfs|nvme|read\.only|readonly|read-only|EROFS|I/O error|input/output|corrupt|abort|timeout|reset"'
    run_capture "$dir/journal-ro-errors.txt" bash -c 'journalctl -b -n 2000 -o short-monotonic | grep -Ei "Read-only file system|read-only|readonly|EROFS|I/O error|Input/output error"'

    run_capture "$dir/systemd-failed.txt" systemctl --failed --no-pager
    run_capture "$dir/watchdog-status.txt" systemctl status zeughaus-ro-watch.service --no-pager

    # Independently retest the write using the same kernel-level errno mechanism.
    run_capture "$dir/write-error-retest.txt" write_test /root/.zeughaus-rw-watch-forensic-test

    printf '%s\n' "$dir" > "$BASE/LAST_INCIDENT"
    log "RO incident captured: $dir"
}

log "started; interval=${INTERVAL}s command_timeout=${COMMAND_TIMEOUT}s"

while :; do
    WRITE_OUTPUT=""
    if WRITE_OUTPUT=$(write_test "$TEST" 2>&1); then
        rm -f "$TEST"
    else
        rc=$?
        WRITE_RC="$rc"
        WRITE_OUTPUT="$(printf '%s\n' "$WRITE_OUTPUT")"
        WRITE_ERRNO="unknown"
        WRITE_ERRNAME="unknown"
        WRITE_ERROR="$WRITE_OUTPUT"

        while IFS='=' read -r key value; do
            case "$key" in
                ERRNO) WRITE_ERRNO="$value" ;;
                ERRNAME) WRITE_ERRNAME="$value" ;;
                ERROR) WRITE_ERROR="$value" ;;
            esac
        done <<< "$WRITE_OUTPUT"

        # The exact errno is authoritative. Only EROFS (30) is a filesystem
        # read-only incident; other errno values are retained as separate clues.
        incident_type="write-failure"
        if [[ "$WRITE_ERRNAME" == "EROFS" || "$WRITE_ERRNO" == "30" ]]; then
            incident_type="ro-incident"
        fi

        incident="${incident_type}-$(date +%Y%m%d-%H%M%S-%N)"
        log "WRITE TEST FAILED type=$incident_type rc=$rc errno=$WRITE_ERRNO errname=$WRITE_ERRNAME error=$WRITE_ERROR"
        capture "$incident"

        # Do not spam captures while the filesystem remains unwritable.
        # Record the duration of the unwritable interval in /run.
        ro_started="$(date --iso-8601=ns)"
        printf 'started=%s\n' "$ro_started" > "$BASE/WRITE_FAILURE_ACTIVE"

        while :; do
            sleep "$INTERVAL"
            if recovery_output=$(write_test "$TEST" 2>&1); then
                rm -f "$BASE/WRITE_FAILURE_ACTIVE" "$TEST"
                ro_restored="$(date --iso-8601=ns)"
                printf 'started=%s\nrestored=%s\n' "$ro_started" "$ro_restored" > "$BASE/WRITE_FAILURE_RECOVERY"
                log "write access restored started=$ro_started restored=$ro_restored"
                break
            fi
            printf '%s\n' "$(date --iso-8601=ns) still_unwritable errno=$(printf '%s\n' "$recovery_output" | awk -F= '/^ERRNO=/{print $2}')" >> "$BASE/WRITE_FAILURE_ACTIVE"
        done
    fi

    sleep "$INTERVAL"
done
