#!/bin/bash
# zeughaus-ro-watch v0.1
# Detects loss of write access to the root Btrfs filesystem and captures
# forensic evidence into /run, which remains writable if / becomes read-only.

set -u

INTERVAL=10
BASE=/run/zeughaus-ro-watch
TEST=/root/.zeughaus-rw-watch-test

mkdir -p "$BASE"
chmod 700 "$BASE"

log() {
    printf '%s %s\n' "$(date --iso-8601=ns)" "$*" | systemd-cat -t zeughaus-ro-watch -p info
}

capture() {
    local incident="$1"
    local dir="$BASE/$incident"
    mkdir -p "$dir"
    chmod 700 "$dir"

    date --iso-8601=ns > "$dir/timestamp.txt"
    printf 'hostname=%s\n' "$(hostname)" > "$dir/host.txt"

    findmnt -T / > "$dir/root-mount.txt" 2>&1 || true
    findmnt -T /run > "$dir/run-mount.txt" 2>&1 || true
    mount > "$dir/mounts.txt" 2>&1 || true

    btrfs filesystem show / > "$dir/btrfs-filesystem-show.txt" 2>&1 || true
    btrfs filesystem usage / > "$dir/btrfs-filesystem-usage.txt" 2>&1 || true
    btrfs device stats / > "$dir/btrfs-device-stats.txt" 2>&1 || true

    journalctl -b -k -n 2000 -o short-monotonic > "$dir/kernel-last-2000.txt" 2>&1 || true
    journalctl -b -k -n 2000 -o short-monotonic | grep -Ei 'btrfs|nvme|read.only|readonly|read-only|EROFS|I/O error|input/output|corrupt|abort|timeout|reset' > "$dir/kernel-btrfs-nvme-ro.txt" 2>&1 || true
    journalctl -b -n 2000 -o short-monotonic | grep -Ei 'Read-only file system|read-only|readonly|EROFS|I/O error|Input/output error' > "$dir/journal-ro-errors.txt" 2>&1 || true

    systemctl --failed --no-pager > "$dir/systemd-failed.txt" 2>&1 || true
    systemctl status zeughaus-ro-watch.service --no-pager > "$dir/watchdog-status.txt" 2>&1 || true

    # Record the exact write-test errno using Python; Python is part of Fedora's
    # base installation and exposes errno reliably without relying on shell text.
    python3 - "$dir/write-error.txt" <<'PY' 2>&1
import errno, os, sys, time
path = "/root/.zeughaus-rw-watch-forensic-test"
try:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.write(fd, b"forensic-test\n")
    os.close(fd)
    os.unlink(path)
    print("RESULT=WRITE_OK")
except OSError as e:
    print(f"RESULT=WRITE_FAILED")
    print(f"ERRNO={e.errno}")
    print(f"ERRNAME={errno.errorcode.get(e.errno, 'UNKNOWN')}")
    print(f"ERROR={e}")
PY

    sync
    printf '%s\n' "$dir" > "$BASE/LAST_INCIDENT"
    log "RO incident captured: $dir"
}

log "started; interval=${INTERVAL}s"

while :; do
    if printf '%s\n' "$(date --iso-8601=ns)" > "$TEST" 2>/tmp/zeughaus-ro-watch-error; then
        rm -f "$TEST" /tmp/zeughaus-ro-watch-error
    else
        rc=$?
        err=$(cat /tmp/zeughaus-ro-watch-error 2>/dev/null || true)
        rm -f "$TEST" /tmp/zeughaus-ro-watch-error

        incident="incident-$(date +%Y%m%d-%H%M%S-%N)"
        log "WRITE TEST FAILED rc=$rc error=$err"
        capture "$incident"

        # Do not spam captures while the filesystem remains unwritable.
        # Wait until write access returns before allowing another incident.
        while ! printf '%s\n' "$(date --iso-8601=ns)" > "$TEST" 2>/dev/null; do
            sleep "$INTERVAL"
        done
        rm -f "$TEST"
        log "write access restored"
    fi

    sleep "$INTERVAL"
done
